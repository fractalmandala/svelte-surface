{
  "name": "@fractaldesign/svelte-surface",
  "version": "0.1.0",
  "description": "Design-to-code surface for SvelteKit and Vite + Svelte: marks, bridge, surgical edit engine, orchestrator, and a standalone editor app (Svelte 5 + TypeScript UI, native macOS WKWebView shell).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "surface-svelte": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/marks/plugin.d.ts",
      "default": "./dist/marks/plugin.js"
    },
    "./edit": {
      "types": "./dist/edit/index.d.ts",
      "default": "./dist/edit/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json && svelte-check --tsconfig app/ui/tsconfig.json --fail-on-warnings",
    "test": "npm run build:app && vitest run",
    "test:only": "vitest run",
    "fixtures:install": "npm --prefix fixtures/svelte4-app install --no-audit --no-fund",
    "demo": "npm run app",
    "app": "npm run build:app && node app-dist/server.mjs --quit-on-close",
    "app:headless": "npm run build:app && node app-dist/server.mjs --no-open",
    "app:bundle": "npm run build:app && node scripts/make-app.ts",
    "build:ui": "node scripts/build-app.ts",
    "app:native": "npm run build:app && node scripts/make-native-app.ts",
    "app:native:open": "npm run build:app && node scripts/make-native-app.ts --no-dmg && open \"dist-app/Surface.app\"",
    "build:app": "npm run build && npm run build:ui",
    "surface:app": "npm run build:app && node app-dist/server.mjs --quit-on-close",
    "test:surface": "npm run build:app && vitest run"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "svelte": ">=4",
    "vite": ">=5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "estree-walker": "^3.0.3",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte4": "npm:svelte@^4.2.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
